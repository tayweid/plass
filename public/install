#!/bin/bash
# Install or update Plass.app:
#
#   curl -fsSL https://plass.tayweid.io/install | bash
#
# This file ships with the site (public/install). Every deploy builds the
# app on a Mac and publishes it beside the site as app/Plass.app.zip
# (.github/workflows/deploy.yml), so this always installs the site's current
# version, and running it again updates. Needs nothing but macOS.
#
# Overrides, for testing: PLASS_SITE (a URL or a local folder holding
# app/Plass.app.zip), PLASS_APP (the .app to write).
set -euo pipefail

site="${PLASS_SITE:-https://plass.tayweid.io}"

die() { printf 'Plass install: %s\n' "$*" >&2; exit 1; }
[ "$(uname -s)" = "Darwin" ] || die "Plass.app is for macOS."

if [ -n "${PLASS_APP:-}" ]; then
    app="$PLASS_APP"
elif [ -w /Applications ]; then
    app="/Applications/Plass.app"
else
    mkdir -p "$HOME/Applications"
    app="$HOME/Applications/Plass.app"
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
echo "Plass: downloading (about 20 MB)…"
case "$site" in
    http*) curl -fsSL -o "$work/Plass.app.zip" "$site/app/Plass.app.zip" ;;
    *) cp "$site/app/Plass.app.zip" "$work/Plass.app.zip" ;;
esac || die "could not download Plass — check the connection and run this again."
ditto -x -k "$work/Plass.app.zip" "$work"
[ -x "$work/Plass.app/Contents/MacOS/Plass" ] || die "the download was incomplete — run this again."

rm -rf "$app"
mkdir -p "$(dirname "$app")"
mv "$work/Plass.app" "$app"
echo "Plass: installed $app — open it from $(dirname "$app")."
