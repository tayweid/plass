{
  "name": "Plass",
  "short_name": "Plass",
  "description": "WYSIWYG editor with publication-quality typesetting",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2a2d",
  "theme_color": "#2b2a2d",
  "icons": [
    { "src": "icons/plass-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/plass-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/plass-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-typst": [".typ"],
        "text/markdown": [".md"]
      }
    }
  ]
}
