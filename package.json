{
  "name": "plass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A true WYSIWYG editor with publication-quality typesetting (oracle layout architecture)",
  "license": "MIT",
  "author": "Taylor J. Weidman",
  "homepage": "https://plass.tayweid.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tayweid/plass.git"
  },
  "bugs": {
    "url": "https://github.com/tayweid/plass/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:sidecar && npm run check:unused && npm run check:exports && npm run check:cycles && tsc --noEmit && vite build",
    "check:cycles": "node --import tsx scripts/check-import-cycles.ts",
    "check:unused": "node --import tsx scripts/check-unused.ts",
    "check:exports": "knip --include exports,types",
    "generate:notices": "node --import tsx scripts/generate-third-party-notices.ts && node --import tsx scripts/generate-sidecar-notices.ts && node --import tsx scripts/generate-typst-wasm-notices.ts",
    "generate:typst-wasm-notices": "node --import tsx scripts/generate-typst-wasm-notices.ts --generate",
    "verify:licenses": "node --import tsx scripts/generate-third-party-notices.ts --check && node --import tsx scripts/generate-sidecar-notices.ts --check && node --import tsx scripts/generate-typst-wasm-notices.ts --check",
    "verify:sidecar": "node --import tsx scripts/verify-sidecar.ts",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "preview": "vite preview",
    "app": "node app/run.mjs",
    "install:local": "node app/install-local.mjs",
    "app:build": "node app/build.mjs",
    "app:install-script": "node app/build.mjs --install-script public/install",
    "app:smoke": "node app/smoke.mjs",
    "test": "node --import tsx scripts/run-unit-tests.ts",
    "test:layout": "tsx src/layout/port/port-smoke.test.ts && tsx src/layout/port/shape-cache.test.ts && tsx src/layout/port/incremental-linebreak.test.ts && tsx src/layout/font-certification.test.ts",
    "test:browser": "playwright test",
    "audit": "PLASS_AUDIT=1 playwright test tests/port-audit.spec.ts --project=chromium --reporter=line",
    "sidecar": "node --import tsx scripts/build-sidecar.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "dompurify": "^3.4.14",
    "hyphenated-en-us": "^1.2.0",
    "hypher": "^0.2.5",
    "katex": "^0.16.11",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.3",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "knip": "^6.38.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vite": "^8.2.2"
  }
}
