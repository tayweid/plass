{
  "name": "plass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A true WYSIWYG editor with publication-quality typesetting (oracle layout architecture)",
  "license": "MIT",
  "author": "Taylor J. Weidman",
  "homepage": "https://plass.tayweid.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tayweid/plass.git"
  },
  "bugs": {
    "url": "https://github.com/tayweid/plass/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "generate:notices": "node --import tsx scripts/generate-third-party-notices.ts",
    "verify:licenses": "node --import tsx scripts/generate-third-party-notices.ts --check",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "preview": "vite preview",
    "test": "tsx src/layout/knuth-plass.test.ts && tsx src/typ-parser.test.ts && tsx src/md-round.test.ts && tsx src/security.test.ts",
    "test:browser": "playwright test",
    "sidecar": "wasm-pack build sidecar --target web --release"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "dompurify": "^3.4.13",
    "hyphenated-en-us": "^1.2.0",
    "hypher": "^0.2.5",
    "katex": "^0.16.11",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.3",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.34.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
